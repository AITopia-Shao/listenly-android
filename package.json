{
  "name": "listenly-android",
  "version": "1.0.11",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AITopia-Shao/listenly-android.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "node tools/build-web-compat.mjs",
    "prepare:demo": "npm run build:web && python tools/prepare-demo-assets.py",
    "start": "node tools/preview.mjs",
    "start:demo": "node tools/preview.mjs --demo",
    "test": "node --test tests/alignment.test.mjs tests/importer.test.mjs tests/activity.test.mjs tests/playback-modes.test.mjs tests/glass-motion.test.mjs",
    "test:demo": "python -m unittest discover -s tests -p test_demo_assets.py",
    "test:ui": "node tests/ui.test.mjs --demo",
    "test:replay": "node tests/audio-replay.test.mjs --demo",
    "test:materials": "python -m unittest discover -s tests -p test_*.py",
    "test:experience": "node tests/theme-home-profile.test.mjs --demo",
    "test:lens": "node tests/nav-lens.test.mjs --demo",
    "test:home": "node tests/home-player.test.mjs --demo",
    "test:quiz": "node tests/compact-quiz.test.mjs --demo",
    "test:glass": "node tests/glass-controls.test.mjs --demo",
    "test:playback": "node tests/playback-modes-browser.test.mjs --demo"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "core-js": "3.50.0",
    "esbuild": "0.28.2",
    "playwright": "1.57.0"
  }
}
